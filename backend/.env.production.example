# Production environment variables
# Kopíruj do .env.production a vyplň měřítka hodnoty

# PostgreSQL connection string
# Formát: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://matrogulike_user:your-strong-password@db.example.com:5432/matrogulike"

# Port na kterém naslouchá server
PORT=3001

# Environment
NODE_ENV=production

# Možné budoucí konfigurace:
# LOG_LEVEL=info
# API_RATE_LIMIT=100
# CORS_ORIGIN=https://yourdomain.com

